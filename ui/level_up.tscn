[gd_scene format=3]

[ext_resource type="Script" path="res://ui/level_up.gd" id="1_level_up"]

[node name="LevelUp" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_level_up")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.03, 0.05, 0.7)

[node name="Center" type="CenterContainer" parent="."]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.86, 0.45, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 40
text = "Szintlépés!"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.72, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
text = "Válassz egy fejlesztést — kattints, vagy nyomd meg az 1, 2, 3 gombot (R: újradobás aranyért)"
horizontal_alignment = 1

[node name="Cards" type="HBoxContainer" parent="Center/Box"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1
